<Project>

  <!--
    Shared settings for every project in the repository.
    The registration pipeline is a compute-bound console tool, so the defaults here
    lean towards throughput (server GC, PGO) and towards catching mistakes at compile
    time (nullable reference types, analyzers as errors).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Mesh files are parsed with an invariant, byte-level parser; no culture data needed. -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Reproducible builds: the same input must yield byte-identical output. -->
    <Deterministic>true</Deterministic>

    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: public members without XML docs. Docs are required on the geometry/algorithm
         surface but enforcing them on every DTO member adds noise without adding clarity. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <Optimize>true</Optimize>
  </PropertyGroup>

</Project>
